<Project>
  <!-- Newest stable versions that support net11.0-windows. -->
  <ItemGroup>
    <!-- AnWa-Soft design library from the local feed, see nuget.config. -->
    <PackageVersion Include="AnWaSoft.Design.Wpf" Version="0.1.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <!-- WiX 5 is used deliberately (no Open Source Maintenance Fee); keep the extensions on the SDK version
       in installer/AnWaSolar.Installer/AnWaSolar.Installer.wixproj. -->
  <ItemGroup>
    <PackageVersion Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageVersion Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
