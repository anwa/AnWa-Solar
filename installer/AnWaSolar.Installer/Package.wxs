<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Per-machine MSI for AnWa-Solar. The UpgradeCode never changes; every build with a
    higher version replaces the installed one (major upgrade).
    The installation folder is read-only for the application: user settings and logs live in
    %LOCALAPPDATA%\AnWa-Solar and are not removed on uninstall.
  -->
  <Package Name="AnWa-Solar"
           Manufacturer="Andreas Wansner"
           Version="$(var.ProductVersion)"
           UpgradeCode="55c1c5ab-3178-461e-a8d7-da8a3b306ef8"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of AnWa-Solar is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.AppIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnWa-Solar" />
    </StandardDirectory>

    <Feature Id="Main" Title="AnWa-Solar" Level="1">
      <!-- All files of the self-contained publish output (including Data\*.json), without debug symbols. -->
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Component Id="LicenseFile" Directory="INSTALLFOLDER">
      <File Id="LicenseTxt" Source="$(var.LicenseFile)" Name="LICENSE.txt" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="815f44e2-687a-4224-b653-8d720e87e045">
      <Shortcut Id="AppShortcut"
                Name="AnWa-Solar"
                Description="Design and check PV strings for inverters"
                Target="[INSTALLFOLDER]AnWa-Solar.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\AnWa-Solar" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- "Launch AnWa-Solar" on the last page, checked by default; runs as the user who started the setup. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch AnWa-Solar" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[INSTALLFOLDER]AnWa-Solar.exe" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\License.rtf" />
  </Package>
</Wix>
