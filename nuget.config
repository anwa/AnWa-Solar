<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources of AnWa-Solar. The AnWa-Soft design library comes from the local feed of the Design repository
     (D:\Workspace\Claude\Design\packages, built with "dotnet pack -c Release" there); everything else from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="anwa-soft-design" value="D:\Workspace\Claude\Design\packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="anwa-soft-design">
      <package pattern="AnWaSoft.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
