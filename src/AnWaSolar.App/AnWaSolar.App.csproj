<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>AnWa-Solar</AssemblyName>
    <RootNamespace>AnWaSolar</RootNamespace>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AnWaSoft.Design.Wpf" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects do not import System.IO implicitly. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnWaSolar.Core\AnWaSolar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources/AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- KaTeX 0.19.1 (MIT) for the formulas in the report preview. -->
    <Content Include="Assets/katex/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- User manual from docs/manual, embedded into the executable (Manual window). -->
  <PropertyGroup>
    <ManualFolder>$(MSBuildThisFileDirectory)..\..\docs\manual\</ManualFolder>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ManualFolder)**\*.md;$(ManualFolder)toc.json" LogicalName="manual/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Build information for the About window: commit of the application and build date. -->
  <Target Name="AddBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceCommit" />
    </Exec>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SourceCommit</_Parameter1>
        <_Parameter2>$(SourceCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildDate</_Parameter1>
        <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
