<!-- AnWa-Solar styles on top of the AnWa-Soft design library (AnWaSoft.Design.Wpf). Colours, the title bar and the
     shared styles come from the library; this dictionary only adds the application icon and binds the result
     states of the calculation to the library's status styles. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:aw="https://anwa-soft.de/design/wpf">

    <!-- Windows and dialogs with the AnWa-Solar icon -->
    <Style x:Key="AppWindow" TargetType="aw:ChromeWindow" BasedOn="{StaticResource AnWaSoft.Window}">
        <Setter Property="Icon" Value="pack://application:,,,/Resources/AppIcon.ico" />
    </Style>

    <Style x:Key="AppDialog" TargetType="aw:ChromeWindow" BasedOn="{StaticResource AnWaSoft.Dialog}">
        <Setter Property="Icon" Value="pack://application:,,,/Resources/AppIcon.ico" />
    </Style>

    <!-- Result states: the State property of the data context (ResultOverview, MpptView, ResultValueRow or
         ResultNote, enum ResultState with Ok, Warning and Error) drives the library's status styles. -->
    <Style x:Key="StateIcon" TargetType="materialDesign:PackIcon" BasedOn="{StaticResource AnWaSoft.StatusIcon}">
        <Setter Property="aw:StatusAssist.Kind" Value="{Binding State, Converter={StaticResource AnWaSoft.StatusKindConverter}}" />
    </Style>

    <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource AnWaSoft.StatusText}">
        <Setter Property="aw:StatusAssist.Kind" Value="{Binding State, Converter={StaticResource AnWaSoft.StatusKindConverter}}" />
    </Style>

    <Style x:Key="StateChip" TargetType="Border" BasedOn="{StaticResource AnWaSoft.StatusChip}">
        <Setter Property="aw:StatusAssist.Kind" Value="{Binding State, Converter={StaticResource AnWaSoft.StatusKindConverter}}" />
    </Style>

    <Style x:Key="StateBanner" TargetType="Border" BasedOn="{StaticResource AnWaSoft.StatusBanner}">
        <Setter Property="aw:StatusAssist.Kind" Value="{Binding State, Converter={StaticResource AnWaSoft.StatusKindConverter}}" />
    </Style>
</ResourceDictionary>
