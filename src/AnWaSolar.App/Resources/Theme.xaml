<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window background and text follow the light or dark Material theme (DynamicResource). -->
    <Style x:Key="AppWindow"
           TargetType="Window">
        <Setter Property="Background"
                Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="Foreground"
                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="TextElement.Foreground"
                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Icon"
                Value="pack://application:,,,/Resources/AppIcon.ico" />
    </Style>
</ResourceDictionary>
