<aw:ChromeWindow x:Class="AnWaSolar.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:aw="https://anwa-soft.de/design/wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:core="clr-namespace:AnWaSolar.Core;assembly=AnWaSolar.Core"
        Title="About AnWa-Solar"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Padding="16,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            MinWidth="88"
                            Click="OnCopyClick">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Copy"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Close"
                            MinWidth="88"
                            IsDefault="True"
                            IsCancel="True"
                            Click="OnCloseClick" />
                </StackPanel>
                <TextBlock x:Name="CopiedText"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StackPanel Margin="28,20,28,12">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">
                <Image Source="pack://application:,,,/Resources/AppIcon.ico"
                       Width="48"
                       Height="48"
                       Margin="0,0,14,0" />
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:AboutSection}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Heading}"
                                       FontWeight="Bold" />
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Read-only text boxes, so that paths and the email address can be selected. -->
                                        <TextBox Text="{Binding Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 TextWrapping="Wrap"
                                                 Style="{x:Null}"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CopyrightText"
                       Opacity="0.7"
                       Margin="0,14,0,0" />
        </StackPanel>
    </DockPanel>
</aw:ChromeWindow>
