<w:ChromeWindow x:Class="AnWaSolar.Windows.AppDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:w="clr-namespace:AnWaSolar.Windows"
                Style="{StaticResource AppDialog}"
                WindowStartupLocation="CenterOwner"
                Width="480"
                SizeToContent="Height">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
            <Button Content="OK"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnOkClick" />
        </Border>
        <DockPanel Margin="24,22,24,20">
            <materialDesign:PackIcon x:Name="KindIcon"
                                     DockPanel.Dock="Left"
                                     Width="32"
                                     Height="32"
                                     Margin="0,0,16,0"
                                     VerticalAlignment="Top" />
            <TextBox x:Name="MessageText"
                     Style="{x:Null}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     MaxHeight="420"
                     VerticalScrollBarVisibility="Auto" />
        </DockPanel>
    </DockPanel>
</w:ChromeWindow>
