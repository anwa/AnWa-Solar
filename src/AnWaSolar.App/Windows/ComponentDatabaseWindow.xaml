<aw:ChromeWindow x:Class="AnWaSolar.Windows.ComponentDatabaseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:aw="https://anwa-soft.de/design/wpf"
                 Style="{StaticResource AppWindow}"
                 WindowStartupLocation="CenterOwner"
                 Title="Component database"
                 Width="1320"
                 Height="860"
                 MinWidth="900"
                 MinHeight="560">
    <DockPanel>
        <Border Style="{StaticResource AnWaSoft.DialogButtonBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnNewSeriesClick"
                            Margin="0,0,8,0"
                            ToolTip="New series of the kind selected on the left"
                            AutomationProperties.Name="New series">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusBoxOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New series" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnImportClick"
                            ToolTip="Read a PDF datasheet as a new series"
                            AutomationProperties.Name="Import datasheet">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Import" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Import…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnDeleteClick"
                            Margin="0,0,8,0"
                            ToolTip="Delete this own series; a shipped series of the same name comes back"
                            AutomationProperties.Name="Delete series">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Delete series" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiscardButton"
                            Content="Discard changes"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnDiscardClick"
                            Margin="0,0,8,0" />
                    <Button x:Name="SaveButton"
                            Content="Save"
                            MinWidth="96"
                            Click="OnSaveClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Kinds, manufacturers and series -->
            <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
                <TreeView x:Name="SeriesTree"
                          Margin="8,12,8,8"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Series" />
            </Border>

            <!-- Series editor -->
            <DockPanel Grid.Column="1" Margin="24,16,24,8">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManufacturerInput"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Manufacturer"
                                 AutomationProperties.Name="Manufacturer"
                                 TextChanged="OnEdited" />
                        <TextBox x:Name="SeriesInput"
                                 Grid.Column="2"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Series"
                                 AutomationProperties.Name="Series name"
                                 TextChanged="OnEdited" />
                    </Grid>
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="OnAttachDatasheetClick"
                                    ToolTip="Attach a PDF datasheet to this series"
                                    AutomationProperties.Name="Attach datasheet">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Paperclip" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Attach PDF…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShowDatasheetButton"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="OnShowDatasheetClick"
                                    AutomationProperties.Name="Show datasheet">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Datasheet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="OnAddVariantClick"
                                    Margin="8,0,0,0"
                                    ToolTip="Add a power class with the values of the last one"
                                    AutomationProperties.Name="Add power class">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableColumnPlusAfter" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Add power class" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="SourceText" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource AnWaSoft.Text.Muted}" />
                    </DockPanel>
                    <TextBlock x:Name="ErrorText"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource AnWaSoft.Brush.Status.Error}"
                               AutomationProperties.Name="Problems" />
                </StackPanel>

                <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="EditorGrid" Margin="0,0,0,12" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</aw:ChromeWindow>
