<aw:ChromeWindow x:Class="AnWaSolar.Windows.DatasheetWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 xmlns:aw="https://anwa-soft.de/design/wpf"
                 Style="{StaticResource AppWindow}"
                 WindowStartupLocation="CenterOwner"
                 Title="Datasheet"
                 Width="1000"
                 Height="820"
                 MinWidth="600"
                 MinHeight="400">
    <Grid>
        <wv2:WebView2 x:Name="Viewer" />
        <TextBlock x:Name="FallbackText"
                   Visibility="Collapsed"
                   Margin="24"
                   TextWrapping="Wrap"
                   Style="{StaticResource AnWaSoft.Text.Muted}" />
    </Grid>
</aw:ChromeWindow>
