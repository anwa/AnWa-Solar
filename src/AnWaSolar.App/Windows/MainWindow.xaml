<aw:ChromeWindow x:Class="AnWaSolar.Windows.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                xmlns:w="clr-namespace:AnWaSolar.Windows"
                xmlns:aw="https://anwa-soft.de/design/wpf"
                xmlns:calc="clr-namespace:AnWaSolar.Core.Calculation;assembly=AnWaSolar.Core"
                Style="{StaticResource AppWindow}"
                Title="AnWa-Solar"
                Width="1360"
                Height="900"
                MinWidth="1040"
                MinHeight="640"
                WindowStartupLocation="CenterScreen">

    <!-- Theme, manual and about in the title bar -->
    <aw:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource AnWaSoft.TitleBarButton}"
                    Click="OnImportDatasheetClick"
                    ToolTip="Import a PDF datasheet of a PV module or inverter"
                    AutomationProperties.Name="Import datasheet">
                <materialDesign:PackIcon Kind="Import" Width="22" Height="22" />
            </Button>
            <Button x:Name="ThemeButton"
                    Style="{StaticResource AnWaSoft.TitleBarButton}"
                    Click="OnThemeClick"
                    AutomationProperties.Name="Theme">
                <materialDesign:PackIcon x:Name="ThemeIcon" Kind="ThemeLightDark" Width="22" Height="22" />
            </Button>
            <Button Style="{StaticResource AnWaSoft.TitleBarButton}"
                    Click="OnManualClick"
                    ToolTip="Manual (F1)"
                    AutomationProperties.Name="Manual">
                <materialDesign:PackIcon Kind="BookOpenVariant" Width="22" Height="22" />
            </Button>
            <Button Style="{StaticResource AnWaSoft.TitleBarButton}"
                    Click="OnAboutClick"
                    ToolTip="About AnWa-Solar"
                    AutomationProperties.Name="About">
                <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22" />
            </Button>
        </StackPanel>
    </aw:ChromeWindow.TitleBarContent>

    <aw:ChromeWindow.Resources>
        <!-- Column layout of the value table of an MPPT result -->
        <Style x:Key="ValueHeader" TargetType="TextBlock" BasedOn="{StaticResource AnWaSoft.Text.Muted}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- One MPPT result -->
        <DataTemplate DataType="{x:Type calc:MpptView}">
            <materialDesign:Card Style="{StaticResource AnWaSoft.Card}" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StateChip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Style="{StaticResource StateIcon}" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource AnWaSoft.Text.CardTitle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource AnWaSoft.Text.Muted}" Margin="0,2,0,0">
                                <TextBlock.Visibility>
                                    <Binding Path="HasRows">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- Voltage window, values against the limits and the allowed module count -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Visibility>
                            <Binding Path="HasRows">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </StackPanel.Visibility>

                        <w:VoltageBar Voltage="{Binding Voltage}"
                                      TrackBrush="{DynamicResource AnWaSoft.Brush.Status.NeutralTint}"
                                      RangeBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                      OkBrush="{DynamicResource AnWaSoft.Brush.Status.Ok}"
                                      ErrorBrush="{DynamicResource AnWaSoft.Brush.Status.Error}"
                                      LimitBrush="{DynamicResource MaterialDesign.Brush.Foreground}"
                                      AutomationProperties.Name="Voltage window" />
                        <WrapPanel Margin="0,6,0,0" TextElement.FontSize="11">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="16" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,5,0" />
                                <TextBlock Text="MPPT range" Style="{StaticResource AnWaSoft.Text.Muted}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="16" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource AnWaSoft.Brush.Status.Ok}" Margin="0,0,5,0" />
                                <TextBlock Text="String Vmpp" Style="{StaticResource AnWaSoft.Text.Muted}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Polygon Points="0,0 10,0 5,8" Fill="{DynamicResource AnWaSoft.Brush.Status.Ok}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Highest string Voc" Style="{StaticResource AnWaSoft.Text.Muted}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="2" Height="12" Fill="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,6,0" />
                                <TextBlock Text="Max. DC voltage" Style="{StaticResource AnWaSoft.Text.Muted}" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUANTITY" Style="{StaticResource ValueHeader}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="1" Text="MIN" Style="{StaticResource ValueHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="MAX" Style="{StaticResource ValueHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="LIMIT (WITH MARGIN)" Style="{StaticResource ValueHeader}" Margin="12,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="2" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type calc:ResultValueRow}">
                                    <Border x:Name="RowBorder" CornerRadius="4" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Quantity}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Min}" Style="{StaticResource StateText}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Max}" Style="{StaticResource StateText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Limit}" Margin="12,0,0,0" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Limit}" />
                                            <materialDesign:PackIcon Grid.Column="4" Style="{StaticResource StateIcon}" Width="16" Height="16" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBorder" Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AnWaSoft.Brush.RowAlternate}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AllowedRange}" Margin="8,10,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Notes -->
                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type calc:ResultNote}">
                                <DockPanel Margin="0,4,0,0">
                                    <materialDesign:PackIcon DockPanel.Dock="Left" Style="{StaticResource StateIcon}" Width="18" Height="18"
                                                             Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource StateText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>
    </aw:ChromeWindow.Resources>

    <Grid>
        <DockPanel>
            <!-- Status bar -->
            <Border x:Name="StatusBar"
                    DockPanel.Dock="Bottom"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    Padding="14,5">
                <DockPanel>
                    <TextBlock x:Name="CopyrightText"
                               DockPanel.Dock="Right"
                               Style="{StaticResource AnWaSoft.Text.Muted}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Style="{StaticResource StateIcon}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Headline}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Status" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="MainTabs"
                        Background="{DynamicResource AnWaSoft.Brush.PanelBackground}"
                        SelectionChanged="OnTabSelectionChanged"
                        materialDesign:ColorZoneAssist.Mode="Standard">
                <TabItem AutomationProperties.Name="String calculation">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SolarPanel" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="String calculation" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="{DynamicResource AnWaSoft.Brush.PanelBackground}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Configuration -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,16,10,8">
                                <TextBlock Text="CONFIGURATION" Style="{StaticResource AnWaSoft.Text.SectionLabel}" />

                                <!-- Inverter -->
                                <materialDesign:Card Style="{StaticResource AnWaSoft.Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="SelectInverterButton"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Click="OnSelectInverterClick"
                                                    AutomationProperties.Name="Select inverter">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="SelectInverterText" Text="Select" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="InverterDatasheetButton"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="36"
                                                    Height="36"
                                                    Margin="0,0,4,0"
                                                    Visibility="Collapsed"
                                                    Click="OnInverterDatasheetClick"
                                                    ToolTip="Show the datasheet of the inverter"
                                                    AutomationProperties.Name="Inverter datasheet">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" />
                                            </Button>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FlashOutline" Width="22" Height="22"
                                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="Inverter" Style="{StaticResource AnWaSoft.Text.CardTitle}" />
                                        </DockPanel>
                                        <TextBlock x:Name="InverterNameText"
                                                   Margin="0,12,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="No inverter selected." />
                                        <UniformGrid x:Name="InverterSpecs" Columns="3" Margin="0,6,0,0" />
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Parameters -->
                                <materialDesign:Card Style="{StaticResource AnWaSoft.Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Click="OnEditParametersClick"
                                                    AutomationProperties.Name="Change parameters">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Change" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Thermometer" Width="22" Height="22"
                                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="Parameters" Style="{StaticResource AnWaSoft.Text.CardTitle}" />
                                        </DockPanel>
                                        <UniformGrid x:Name="ParameterTiles" Columns="3" Margin="0,12,0,0" />
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Strings: one card per MPPT, created in code -->
                                <TextBlock x:Name="StringsLabel" Text="STRINGS" Style="{StaticResource AnWaSoft.Text.SectionLabel}" Margin="4,8,0,8" Visibility="Collapsed" />
                                <StackPanel x:Name="StringsPanel" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Results -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResultsPanel" Margin="10,16,20,8">
                                <DockPanel Margin="0,0,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28"
                                            Padding="8,0"
                                            Margin="0,-8,0,0"
                                            Click="OnCopyResultsClick"
                                            ToolTip="Copy the results as text"
                                            AutomationProperties.Name="Copy results">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Copy" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="RESULTS" Style="{StaticResource AnWaSoft.Text.SectionLabel}" />
                                </DockPanel>

                                <!-- Overall result -->
                                <Border Style="{StaticResource StateBanner}" AutomationProperties.Name="Overall result">
                                    <DockPanel>
                                        <materialDesign:PackIcon DockPanel.Dock="Left" Style="{StaticResource StateIcon}"
                                                                 Width="32" Height="32" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource AnWaSoft.Text.Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Mppts}" Focusable="False" />

                                <!-- Effective limits -->
                                <materialDesign:Card x:Name="LimitsCard" Style="{StaticResource AnWaSoft.Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldCheckOutline" Width="22" Height="22"
                                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="Inverter limits" Style="{StaticResource AnWaSoft.Text.CardTitle}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding LimitsCaption}" Style="{StaticResource AnWaSoft.Text.Muted}" Margin="0,4,0,10" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="LIMIT" Style="{StaticResource ValueHeader}" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="DATASHEET" Style="{StaticResource ValueHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="WITH MARGIN" Style="{StaticResource ValueHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Limits}" AlternationCount="2" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type calc:LimitRow}">
                                                    <Border x:Name="RowBorder" CornerRadius="4" Padding="0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Datasheet}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                                                       Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Effective}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                                                       FontWeight="SemiBold" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="RowBorder" Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AnWaSoft.Brush.RowAlternate}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource AnWaSoft.Text.Muted}" FontSize="12" Margin="8,10,0,0"
                                                   Text="Min and max are taken over the cell temperature range: voltages are highest at Tmin, currents at Tmax." />
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Report -->
                <TabItem x:Name="ReportTab" AutomationProperties.Name="Report">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="{DynamicResource AnWaSoft.Brush.PanelBackground}">
                        <materialDesign:Card Style="{StaticResource AnWaSoft.Card}" Margin="20,16,20,16" Padding="0">
                            <DockPanel>
                                <!-- Toolbar -->
                                <Border DockPanel.Dock="Top"
                                        Padding="16,10"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Margin="0,0,8,0"
                                                    Click="OnCopyReportClick"
                                                    AutomationProperties.Name="Copy Markdown">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy Markdown" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnSaveReportClick"
                                                    AutomationProperties.Name="Save Markdown">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Save Markdown" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <ListBox x:Name="ReportViewSelector"
                                                 Style="{StaticResource MaterialDesignToolToggleListBox}"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnReportViewChanged"
                                                 HorizontalAlignment="Left"
                                                 AutomationProperties.Name="Report view">
                                            <ListBoxItem AutomationProperties.Name="Preview">
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <materialDesign:PackIcon Kind="EyeOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Preview" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem AutomationProperties.Name="Markdown">
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <materialDesign:PackIcon Kind="LanguageMarkdownOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Markdown" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <TextBox x:Name="ReportMarkdownTextBox"
                                             Style="{x:Null}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Padding="16,12"
                                             Background="Transparent"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="13"
                                             VerticalScrollBarVisibility="Auto"
                                             Visibility="Collapsed"
                                             AutomationProperties.Name="Markdown source" />
                                    <Grid x:Name="ReportPreviewContainer">
                                        <wv2:WebView2 x:Name="ReportPreviewBrowser" />
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <materialDesign:Snackbar x:Name="Snackbar"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,40"
                                 MessageQueue="{materialDesign:MessageQueue}" />
    </Grid>
</aw:ChromeWindow>
