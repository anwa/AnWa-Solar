<Window x:Class="AnWaSolar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AnWa-Solar"
        Height="1200"
        Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DockPanel>
            <materialDesign:ColorZone Mode="PrimaryMid"
                                      DockPanel.Dock="Top"
                                      Padding="16">
                <DockPanel>
                    <TextBlock Text="AnWa-Solar"
                               Foreground="White"
                               FontSize="18"
                               VerticalAlignment="Center" />
                </DockPanel>
            </materialDesign:ColorZone>

            <TabControl Margin="8">
                <TabItem Header="String calculation">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16"
                                    Orientation="Vertical">

                            <!-- Section 1: inverter -->
                            <materialDesign:Card Padding="16"
                                                 Margin="0,0,0,12">
                                <StackPanel Orientation="Vertical">
                                    <DockPanel>
                                        <TextBlock Text="Inverter"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   DockPanel.Dock="Left" />
                                        <Button x:Name="SelectInverterButton"
                                                Content="Select inverter"
                                                DockPanel.Dock="Right"
                                                Click="OnSelectInverterClick"
                                                Margin="8,0,0,0" />
                                    </DockPanel>
                                    <TextBlock x:Name="InverterSummaryText"
                                               Margin="0,8,0,0"
                                               Text="No inverter selected." />
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Section 2: strings (one section per MPPT) -->
                            <materialDesign:Card Padding="16"
                                                 Margin="0,0,0,12"
                                                 x:Name="StringsCard"
                                                 Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Strings"
                                               FontWeight="Bold"
                                               FontSize="16" />
                                    <TextBlock x:Name="StringsHintText"
                                               Margin="0,6,0,12"
                                               Text="Select a PV module for each MPPT and set the counts." />
                                    <StackPanel x:Name="StringsPanel"
                                                Orientation="Vertical" />
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Section 3: results -->
                            <materialDesign:Card Padding="16"
                                                 Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Results"
                                               FontWeight="Bold"
                                               FontSize="16" />
                                    <TextBlock x:Name="ResultsOutput"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="No calculation yet." />
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Section 4: parameters -->
                            <materialDesign:Card Padding="16">
                                <StackPanel Orientation="Vertical">
                                    <DockPanel>
                                        <TextBlock Text="Parameters"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   DockPanel.Dock="Left" />
                                        <Button Content="Change parameters"
                                                DockPanel.Dock="Right"
                                                Click="OnEditParametersClick"
                                                Margin="8,0,0,0" />
                                    </DockPanel>
                                    <TextBlock x:Name="ParametersSummaryText"
                                               Margin="0,8,0,0"
                                               Text="Tmin, Tmax and the safety margin are shown here." />
                                </StackPanel>
                            </materialDesign:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Report: uses the whole tab area -->
                <TabItem Header="Report">
                    <Grid Margin="16">
                        <materialDesign:Card Padding="16"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header with view switch -->
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="Report"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               DockPanel.Dock="Left" />
                                    <Button Content="Switch view (Markdown/preview)"
                                            DockPanel.Dock="Right"
                                            Click="OnToggleReportViewClick"
                                            Margin="8,0,0,0" />
                                </DockPanel>

                                <!-- Content area: fills the available space -->
                                <Grid Grid.Row="1">
                                    <!-- Markdown source -->
                                    <TextBox x:Name="ReportMarkdownTextBox"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             VerticalScrollBarVisibility="Auto"
                                             materialDesign:HintAssist.Hint="Markdown source of the report" />
                                    <!-- HTML preview -->
                                    <Grid x:Name="ReportPreviewContainer"
                                          Visibility="Collapsed">
                                        <WebBrowser x:Name="ReportPreviewBrowser"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Grid>

                                <!-- Actions -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">
                                    <Button Content="Copy Markdown"
                                            Margin="0,0,8,0"
                                            Click="OnCopyReportClick" />
                                    <Button Content="Save Markdown"
                                            Click="OnSaveReportClick" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
