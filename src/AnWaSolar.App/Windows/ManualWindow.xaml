<Window x:Class="AnWaSolar.Windows.ManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:manual="clr-namespace:AnWaSolar.Core.Manual;assembly=AnWaSolar.Core"
        Style="{StaticResource AppWindow}"
        Title="AnWa-Solar Manual"
        Width="1100"
        Height="720"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <materialDesign:ColorZone Mode="PrimaryMid"
                                  DockPanel.Dock="Top"
                                  Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="BookOpenVariant"
                                         Foreground="White"
                                         Width="22"
                                         Height="22"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderText"
                           Text="Manual"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center" />
            </StackPanel>
        </materialDesign:ColorZone>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"
                                  MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Grid.Column="0"
                       Margin="12,12,8,8">
                <DockPanel DockPanel.Dock="Top"
                           Margin="0,0,0,8">
                    <Button x:Name="BackButton"
                            DockPanel.Dock="Left"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="36"
                            Height="36"
                            Click="OnBackClick"
                            ToolTip="Back (Alt+Left)"
                            AutomationProperties.Name="Back">
                        <materialDesign:PackIcon Kind="ArrowLeft" />
                    </Button>
                    <TextBox x:Name="SearchBox"
                             Margin="6,0,0,0"
                             TextChanged="OnSearchChanged"
                             materialDesign:HintAssist.Hint="Search manual…"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             AutomationProperties.Name="Search manual" />
                </DockPanel>

                <Grid>
                    <TreeView x:Name="PageTree"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              AutomationProperties.Name="Pages">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type manual:ManualNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <ListBox x:Name="HitList"
                             Visibility="Collapsed"
                             SelectionChanged="OnHitSelected"
                             AutomationProperties.Name="Search results">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type manual:ManualHit}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Breadcrumb}"
                                               Opacity="0.7"
                                               FontSize="11" />
                                    <ItemsControl ItemsSource="{Binding Snippets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoHitsText"
                               Text="No pages found."
                               Opacity="0.7"
                               Margin="8"
                               Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesign.Brush.Separator}" />

            <!-- Page -->
            <wv2:WebView2 x:Name="PageView"
                          Grid.Column="2" />
            <TextBlock x:Name="UnavailableText"
                       Grid.Column="2"
                       Margin="24"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
