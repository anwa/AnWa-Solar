<aw:ChromeWindow x:Class="AnWaSolar.Windows.ParametersWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:aw="https://anwa-soft.de/design/wpf"
                Style="{StaticResource AppDialog}"
                WindowStartupLocation="CenterOwner"
                Title="Calculation parameters"
                Width="900"
                SizeToContent="Height">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="Save"
                        MinWidth="96"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>

        <Grid Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="String calculation" Style="{StaticResource AnWaSoft.Text.CardTitle}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource AnWaSoft.Text.Muted}"
                           Margin="0,0,0,16"
                           Text="Tmin and Tmax are module (cell) temperatures. The safety margin reduces maximum limits and raises minimum limits." />
                <TextBox x:Name="MinTempInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Min. cell temperature (°C)"
                         materialDesign:HintAssist.HelperText="Coldest expected cell temperature, for example -20"
                         materialDesign:TextFieldAssist.SuffixText="°C"
                         Margin="0,0,0,26" />
                <TextBox x:Name="MaxTempInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Max. cell temperature (°C)"
                         materialDesign:HintAssist.HelperText="Hottest expected cell temperature, for example 70"
                         materialDesign:TextFieldAssist.SuffixText="°C"
                         Margin="0,0,0,26" />
                <TextBox x:Name="SafetyMarginInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Safety margin (%)"
                         materialDesign:HintAssist.HelperText="0 to 50 %, for example 10"
                         materialDesign:TextFieldAssist.SuffixText="%"
                         Margin="0,0,0,20" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="AC side and grid connection" Style="{StaticResource AnWaSoft.Text.CardTitle}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource AnWaSoft.Text.Muted}"
                           Margin="0,0,0,16"
                           Text="Limits of your grid operator and your design goals; check them against the current rules (VDE-AR-N 4105)." />
                <TextBox x:Name="UnbalancedInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Unbalanced load limit (kVA)"
                         materialDesign:HintAssist.HelperText="Max. apparent power of a single-phase inverter, for example 4.6"
                         materialDesign:TextFieldAssist.SuffixText="kVA"
                         Margin="0,0,0,26" />
                <TextBox x:Name="RegistrationInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Simplified registration up to (kVA)"
                         materialDesign:HintAssist.HelperText="System size of the simplified grid registration, for example 30"
                         materialDesign:TextFieldAssist.SuffixText="kVA"
                         Margin="0,0,0,26" />
                <TextBox x:Name="FeedInInput"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Feed-in limit (%)"
                         materialDesign:HintAssist.HelperText="Of the PV peak power; 100 means no limit"
                         materialDesign:TextFieldAssist.SuffixText="%"
                         Margin="0,0,0,26" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RatioMinInput"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="DC/AC ratio from"
                             materialDesign:HintAssist.HelperText="Recommended range, for example 0.9"
                             materialDesign:TextFieldAssist.SuffixText=""
                             Margin="0,0,0,20" />
                    <TextBox Grid.Column="2" x:Name="RatioMaxInput"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="DC/AC ratio up to"
                             materialDesign:HintAssist.HelperText="for example 1.3"
                             materialDesign:TextFieldAssist.SuffixText=""
                             Margin="0,0,0,20" />
                </Grid>
            </StackPanel>
        </Grid>
    </DockPanel>
</aw:ChromeWindow>
