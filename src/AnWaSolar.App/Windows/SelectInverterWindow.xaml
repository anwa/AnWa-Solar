<w:ChromeWindow x:Class="AnWaSolar.Windows.SelectInverterWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:w="clr-namespace:AnWaSolar.Windows"
                Style="{StaticResource AppDialog}"
                WindowStartupLocation="CenterOwner"
                Title="Select inverter"
                Width="640"
                SizeToContent="Height">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="Apply"
                        MinWidth="96"
                        IsDefault="True"
                        Click="OnAcceptClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ManufacturerCombo"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Manufacturer"
                          SelectionChanged="OnManufacturerSelectionChanged" />
                <ComboBox x:Name="ModelCombo"
                          Grid.Column="2"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Model"
                          SelectionChanged="OnModelSelectionChanged" />
            </Grid>

            <Border Margin="0,20,0,0"
                    Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource App.PanelBackground}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="FlashOutline" Width="20" Height="20" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="Datasheet values" Style="{StaticResource CardTitle}" FontSize="14" />
                    </StackPanel>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Manufacturer" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailManufacturer" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Model" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailModel" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="MPPT voltage range (V)" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailMppt" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Max. DC input voltage (V)" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailVdcMax" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="Start voltage (V)" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailStart" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="I_in_max / I_sc_max (A)" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailCurrents" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Text="MPPTs / max. strings per MPPT" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetailMpptCount" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</w:ChromeWindow>
