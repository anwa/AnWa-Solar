<Window x:Class="AnWaSolar.Windows.SelectModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource AppWindow}"
        Title="Select PV module"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <DockPanel>
            <materialDesign:ColorZone Mode="PrimaryMid"
                                      DockPanel.Dock="Top"
                                      Padding="12">
                <TextBlock Text="PV module selection"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center" />
            </materialDesign:ColorZone>

            <StackPanel Margin="12"
                        Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,8,0">
                        <TextBlock Text="Manufacturer" />
                        <ComboBox x:Name="ManufacturerCombo"
                                  IsEditable="False"
                                  SelectionChanged="OnManufacturerSelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0">
                        <TextBlock Text="Model" />
                        <ComboBox x:Name="ModelCombo"
                                  IsEditable="False"
                                  SelectionChanged="OnModelSelectionChanged" />
                    </StackPanel>
                </Grid>

                <materialDesign:Card Margin="0,12,0,0"
                                     Padding="8">
                    <StackPanel>
                        <TextBlock Text="Details"
                                   FontWeight="Bold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Manufacturer" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       x:Name="DetailManufacturer"
                                       Text="-" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Model" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       x:Name="DetailModel"
                                       Text="-" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Pmax (W)" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       x:Name="DetailPmax"
                                       Text="-" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Vmpp (V) / Impp (A)" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       x:Name="DetailMpp"
                                       Text="-" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Voc (V) / Isc (A)" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       x:Name="DetailOcSc"
                                       Text="-" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Temp. coeff. Pmax / Voc / Isc (%/°C)" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       x:Name="DetailCoeffs"
                                       Text="-" />
                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Operating temperature (°C)" />
                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       x:Name="DetailTempRange"
                                       Text="-" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancel"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="Apply"
                            IsDefault="True"
                            Click="OnAcceptClick" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
