<aw:ChromeWindow x:Class="AnWaSolar.Windows.SelectModuleWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:aw="https://anwa-soft.de/design/wpf"
                Style="{StaticResource AppDialog}"
                WindowStartupLocation="CenterOwner"
                Title="Select PV module"
                Width="700"
                SizeToContent="Height">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}">
            <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="OnImportClick"
                        Margin="0,0,8,0"
                        ToolTip="Read a PDF datasheet and add its values to your own master data"
                        AutomationProperties.Name="Import datasheet">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="DatasheetButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="OnDatasheetClick"
                        IsEnabled="False"
                        ToolTip="Show the imported datasheet of this entry"
                        AutomationProperties.Name="Show datasheet">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Datasheet" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="Apply"
                        MinWidth="96"
                        IsDefault="True"
                        Click="OnAcceptClick" />
            </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ManufacturerCombo"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Manufacturer"
                          SelectionChanged="OnManufacturerSelectionChanged" />
                <ComboBox x:Name="ModelCombo"
                          Grid.Column="2"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Model"
                          SelectionChanged="OnModelSelectionChanged" />
            </Grid>

            <Border Margin="0,20,0,0"
                    Padding="16,12"
                    CornerRadius="10"
                    Background="{DynamicResource AnWaSoft.Brush.PanelBackground}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="SolarPanel" Width="20" Height="20" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="Datasheet values" Style="{StaticResource AnWaSoft.Text.CardTitle}" FontSize="14" />
                    </StackPanel>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Manufacturer" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailManufacturer" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Model" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailModel" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Pmax (W)" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailPmax" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Vmpp (V) / Impp (A)" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailMpp" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="Voc (V) / Isc (A)" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailOcSc" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="Temp. coeff. Pmax / Voc / Isc (%/°C)" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailCoeffs" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Text="Operating temperature (°C)" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetailTempRange" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Text="Source" Foreground="{DynamicResource AnWaSoft.Brush.TextMuted}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DetailSource" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</aw:ChromeWindow>
