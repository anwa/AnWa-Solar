<aw:ChromeWindow x:Class="AnWaSolar.Windows.StartProjectWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:aw="https://anwa-soft.de/design/wpf"
                 Style="{StaticResource AppDialog}"
                 WindowStartupLocation="CenterScreen"
                 Title="Open project"
                 Width="620"
                 SizeToContent="Height">
    <DockPanel>
        <Border Style="{StaticResource AnWaSoft.DialogButtonBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnNewClick"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="New project">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderPlusOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New project…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnOtherClick"
                            ToolTip="Open a project file that is not in the list"
                            AutomationProperties.Name="Other project">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Other…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button x:Name="OpenButton"
                            Content="Open"
                            MinWidth="96"
                            IsDefault="True"
                            Click="OnOpenClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="Recent projects" Style="{StaticResource AnWaSoft.Text.CardTitle}" Margin="0,0,0,10" />
            <ListBox x:Name="RecentList"
                     AutomationProperties.Name="Recent projects"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,6">
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FolderOutline" Width="20" Height="20"
                                                     Margin="0,2,12,0" VerticalAlignment="Top"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource AnWaSoft.Text.Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText"
                       Text="No projects yet. Create a new project."
                       Style="{StaticResource AnWaSoft.Text.Muted}"
                       Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</aw:ChromeWindow>
